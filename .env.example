# ═══════════════════════════════════════════════════
# Noezema v0.1 — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ─── LLM Gateway ──────────────────────────────────
# OpenAI-compatible API (llama.cpp, Ollama, vLLM, LiteLLM)
LLM_API_BASE=http://localhost:8080/v1
LLM_MODEL=qwen3.6-27b-q6_k-mtp
LLM_API_KEY=sk-placeholder  # Leave blank if no auth required
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ─── Database ─────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/noezema

# ─── Redis ────────────────────────────────────────
# For RQ task queue
REDIS_URL=redis://redis:6379/0

# ─── Web API ──────────────────────────────────────
# FastAPI server settings
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# ─── Orchestrator ─────────────────────────────────
# Session and tool configuration
WORKSPACE_DIR=/tmp/noezema-workspace
MAX_EXPLORER_STEPS=10
MAX_TOOL_TIMEOUT=60

# ─── Tool Broker Limits ───────────────────────────
# Rate limits per tool (calls per window_seconds)
BASH_RATE_LIMIT=10
PYTHON_RATE_LIMIT=10
WEB_FETCH_RATE_LIMIT=5
SEARCH_RATE_LIMIT=5
RATE_WINDOW=60

# ─── Security ─────────────────────────────────────
# Allowed domains for web_fetch (comma-separated, empty = all)
# WEB_FETCH_ALLOWED_DOMAINS=

# Blocked shell commands (comma-separated)
BLOCKED_COMMANDS=sudo,chmod,chmod +s,chown,mount,umount,fdisk,dd

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG  # Enable for troubleshooting
