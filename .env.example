# ═══════════════════════════════════════════════════
# Noezema — environment configuration (impl/from-scratch)
# Copy to .env and fill in your values.
# Convention: NOEZEMA_ prefix (pydantic-settings).
# ═══════════════════════════════════════════════════

# ─── Database (PostgreSQL 15+, asyncpg) ────────────
NOEZEMA_DATABASE_URL=postgresql+asyncpg://noezema:noezema_dev@127.0.0.1:5432/noezema

# ─── LLM Gateway (local OpenAI-compatible endpoint) ─
NOEZEMA_LLM_BASE_URL=http://127.0.0.1:8080/v1
NOEZEMA_LLM_MODEL=thinker-local
NOEZEMA_LLM_API_KEY=
NOEZEMA_LLM_TIMEOUT=120
NOEZEMA_LLM_MAX_OUTPUT_TOKENS=4096

# ─── Web (FastAPI) ─────────────────────────────────
NOEZEMA_WEB_HOST=127.0.0.1
NOEZEMA_WEB_PORT=8000
NOEZEMA_WEB_ADMIN_PASSWORD=

# ─── Orchestrator / workspace ──────────────────────
NOEZEMA_WORKSPACE_DIR=/var/lib/noezema/workspace
NOEZEMA_MAX_EXPLORER_STEPS=10

# ─── Logging ───────────────────────────────────────
NOEZEMA_LOG_LEVEL=INFO
# NOEZEMA_LOG_LEVEL=DEBUG
