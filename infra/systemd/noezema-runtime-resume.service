[Unit]
Description=Recover and start the NOEZEMA cognitive runtime
After=local-fs.target network.target
Wants=network.target
StartLimitIntervalSec=5min
StartLimitBurst=6
OnFailure=noezema-resume-failure@%n.service

[Service]
Type=oneshot
User=root
Group=noezema-host
EnvironmentFile=/etc/noezema/noezema-runtime.env
Environment=NOEZEMA_RECOVERY_CREATE_IF_ABSENT=1
WorkingDirectory=/opt/noezema
ExecStart=/opt/noezema/.venv/bin/python -m apps.host_control.resume
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=78
TimeoutStartSec=20s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/noezema
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
