# Install as /etc/noezema/noezema-runtime.env with owner root:noezema and mode 0640.
NOEZEMA_DATABASE_URL=postgresql+psycopg://noezema@/noezema?host=/var/run/postgresql
NOEZEMA_WORKSPACE_ROOT=/var/lib/noezema/workspace
NOEZEMA_ARTIFACT_STORE_ROOT=/var/lib/noezema/artifacts
NOEZEMA_HOST_STATE_ROOT=/var/lib/noezema
NOEZEMA_HOST_TRANSITION_LOCK_PATH=/run/lock/noezema-host-transition.lock
NOEZEMA_HOST_RECOVERY_DEFAULTS_PATH=/usr/lib/noezema/host-recovery.defaults.toml
NOEZEMA_HOST_RECOVERY_OVERRIDE_PATH=/etc/noezema/host-recovery.toml
NOEZEMA_MAINTENANCE_MARKER_PATH=/run/noezema-offline-rules/active
NOEZEMA_HOST_TRANSITION_HEAD_PATH=/var/lib/noezema/host-transition-head.json
NOEZEMA_HOST_POLICY_CHANGE_HEAD_PATH=/var/lib/noezema/host-policy-change-head.json
NOEZEMA_LLM_BASE_URL=http://127.0.0.1:8080/v1
NOEZEMA_LLM_MODEL=local-model
NOEZEMA_LLM_MODEL_SHA256=replace-with-64-hex-characters
NOEZEMA_LLM_TOKENIZER_SHA256=replace-with-64-hex-characters
NOEZEMA_LLM_TEMPLATE_SHA256=replace-with-64-hex-characters
NOEZEMA_LLM_GRAMMAR_SHA256=replace-with-64-hex-characters
NOEZEMA_LLM_BACKEND=llama.cpp
NOEZEMA_LLM_BACKEND_VERSION=replace-me
NOEZEMA_LLM_BUILD_FINGERPRINT=replace-me
