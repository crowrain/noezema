# Install as /etc/noezema/noezema-web.env with owner root:noezema-observer and mode 0640.
NOEZEMA_DATABASE_URL=postgresql+psycopg://noezema-web@/noezema?host=/var/run/postgresql
NOEZEMA_WEB_ADMIN_PASSWORD_SCRYPT=replace-with-scrypt-hash
NOEZEMA_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
NOEZEMA_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8765
NOEZEMA_WEB_COOKIE_SECURE=false
NOEZEMA_UNIT_STATE_TTL_SECONDS=15
