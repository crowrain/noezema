[Unit]
Description=Persist a NOEZEMA unclassified resume failure for %i

[Service]
Type=oneshot
User=root
Group=noezema-host
Environment=NOEZEMA_FAILED_RESUME_UNIT=%i
EnvironmentFile=/etc/noezema/noezema-runtime.env
WorkingDirectory=/opt/noezema
ExecStart=/opt/noezema/.venv/bin/python -m apps.host_control.failure_handler
TimeoutStartSec=20s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/noezema
RestrictAddressFamilies=AF_UNIX
