# The base has no default on purpose. Supply an immutable Python image reference,
# for example registry.example/python@sha256:<digest>.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT []
CMD ["python3", "--version"]
